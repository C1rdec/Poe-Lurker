<UserControl x:Class="PoeLurker.UI.Views.BuildDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:Converters="clr-namespace:PoeLurker.UI.Converters"
             xmlns:local="clr-namespace:PoeLurker.UI.Controls"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                Margin="0,4,0,0"
                cal:Message.Attach="[Event MouseLeftButtonUp] = [Action BackToBuildSelector]"
                Cursor="Hand"
                ToolTip="Back to builds"
                CornerRadius="4"
                Background="#2e2614"
                BorderBrush="#af8404"
                BorderThickness="3,1,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1"
                      Visibility="{Binding HasNoBuildName, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="20,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="24"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Column="1"
                      Visibility="{Binding HasBuildName, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="20,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="24"
                               Text="{Binding BuildName}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Grid.Column="0"
                            Margin="20,0,0,0"
                            MinWidth="50"
                            Orientation="Horizontal">
                    <Image Height="50"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           Source="/Assets/LurkerIcon.png">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnknownAscendancy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Height="50" Source="/Assets/Assassin_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Assassin'}" />
                    <Image Height="50" Source="/Assets/Ascendant_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Ascendant'}" />
                    <Image Height="50" Source="/Assets/Berserker_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Berserker'}" />
                    <Image Height="50" Source="/Assets/Champion_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Champion'}" />
                    <Image Height="50" Source="/Assets/Chieftain_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Chieftain'}" />
                    <Image Height="50" Source="/Assets/Deadeye_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Deadeye'}" />
                    <Image Height="50" Source="/Assets/Elementalist_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Elementalist'}" />
                    <Image Height="50" Source="/Assets/Gladiator_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Gladiator'}" />
                    <Image Height="50" Source="/Assets/Guardian_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Guardian'}" />
                    <Image Height="50" Source="/Assets/Hierophant_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Hierophant'}" />
                    <Image Height="50" Source="/Assets/Inquisitor_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Inquisitor'}" />
                    <Image Height="50" Source="/Assets/Juggernaut_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Juggernaut'}" />
                    <Image Height="50" Source="/Assets/Necromancer_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Necromancer'}" />
                    <Image Height="50" Source="/Assets/Occultist_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Occultist'}" />
                    <Image Height="50" Source="/Assets/Pathfinder_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Pathfinder'}" />
                    <Image Height="50" Source="/Assets/Raider_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Raider'}" />
                    <Image Height="50" Source="/Assets/Saboteur_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Saboteur'}" />
                    <Image Height="50" Source="/Assets/Slayer_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Slayer'}" />
                    <Image Height="50" Source="/Assets/Trickster_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Trickster'}" />
                    <Image Height="50" Source="/Assets/Titan_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Titan'}" />
                    <Image Height="50" Source="/Assets/Warbringer_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Warbringer'}" />
                    <Image Height="50" Source="/Assets/Stormweaver_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Stormweaver'}" />
                    <Image Height="50" Source="/Assets/Chronomancer_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Chronomancer'}" />
                    <Image Height="50" Source="/Assets/Infernalist_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Infernalist'}" />
                    <Image Height="50" Source="/Assets/BloodMage_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Blood Mage'}" />
                    <Image Height="50" Source="/Assets/Witchhunter_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Witchhunter'}" />
                    <Image Height="50" Source="/Assets/GemlingLegionnaire_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Gemling Legionnaire'}" />
                    <Image Height="50" Source="/Assets/Invoker_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Invoker'}" />
                    <Image Height="50" Source="/Assets/AcolyteOfChayula_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Acolyte of Chayula'}" />
                    <Image Height="50" Source="/Assets/DiscipleOfVarashta_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Disciple of Varashta'}" />
                    <Image Height="50" Source="/Assets/Ritualist_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Ritualist'}" />
                    <Image Height="50" Source="/Assets/Amazon_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Amazon'}" />
                    <Image Height="50" Source="/Assets/Lich_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Lich'}" />
                    <Image Height="50" Source="/Assets/Shaman_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Shaman'}" />
                    <Image Height="50" Source="/Assets/SmithOfKitava_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Smith of Kitava'}" />
                    <Image Height="50" Source="/Assets/AbyssalLich_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Abyssal Lich'}" />
                    <Image Height="50" Source="/Assets/Tactician_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Tactician'}" />
                    <Image Height="50" Source="/Assets/Oracle_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Oracle'}" />
                    <Image Height="50" Source="/Assets/Warden_avatar.png" Visibility="{Binding Ascendancy, Converter={Converters:StringConverter}, ConverterParameter='Warden'}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,10"
                CornerRadius="4"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#af8404" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ItemFilterEnabled}" Value="False">
                            <Setter Property="BorderBrush" Value="#5a5a5a" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="12,0,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="26"
                               Text="Item Filter" />
                    <Controls:ToggleSwitch Grid.Column="1"
                                           Header=""
                                           Margin="0,-15,0,0"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           IsOn="{Binding ItemFilterEnabled, Mode=TwoWay}" />
                </Grid>

                <Grid Grid.Row="1"
                      Visibility="{Binding ItemFilterEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Visibility="{Binding MainFilterViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,8,0,4"
                                   FontSize="20"
                                   Text="NerverSink Base Filter" />

                        <ComboBox Grid.Row="1"
                                  FontSize="18"
                                  Cursor="Hand"
                                  ItemsSource="{Binding BaseFilters}"
                                  SelectedItem="{Binding SelectedBaseFilter, Mode=TwoWay}" />

                        <Button x:Name="OpenAdditionalFilterEditor"
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                HorizontalContentAlignment="Stretch">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="Additional Condition" />
                                <TextBlock Margin="0,-4,8,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Text="●"
                                           Visibility="{Binding HasAdditionalFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#808080" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanSaveFilter}" Value="True">
                                                    <Setter Property="Foreground" Value="#7ecb7e" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>

                        <Button x:Name="SaveFilter"
                                Grid.Row="4"
                                Margin="0,12,0,0"
                                VerticalAlignment="Bottom"
                                Content="Apply">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Setter Property="Background" Value="#af8404" />
                                    <Setter Property="BorderBrush" Value="#af8404" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Visibility="{Binding AdditionalFilterEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,8,0,4"
                                   FontSize="20"
                                   Text="Additional Condition" />

                        <local:BindableTextEditor Grid.Row="1"
                                                  MinHeight="120"
                                                  Padding="10"
                                                  FontFamily="Consolas"
                                                  FontSize="14"
                                                  Background="Transparent"
                                                  Foreground="White"
                                                  CompletionProvider="{Binding CompletionProvider}"
                                                  ShowLineNumbers="True"
                                                  LineNumbersForeground="#808080"
                                                  BoundText="{Binding AdditionalFilterDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  WordWrap="False" />

                        <Button x:Name="AddAdditionalFilter"
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Content="Save" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Controls:ToggleSwitch Margin="0,0,0,8"
                                   Header="Passives"
                                   IsOn="{Binding IncludePassives, Mode=TwoWay}" />

            <Controls:ToggleSwitch Margin="0,0,0,8"
                                   Grid.Column="1"
                                   Header="Items"
                                   IsOn="{Binding IncludeInventorySlots, Mode=TwoWay}" />
            <Controls:ToggleSwitch Header="Skills"
                                   Grid.Column="2"
                                   IsOn="{Binding IncludeSkills, Mode=TwoWay}" />
        </Grid>
    </Grid>
</UserControl>

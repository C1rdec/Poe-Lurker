<UserControl x:Class="PoeLurker.UI.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PoeLurker.UI.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <ComboBox HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Cursor="Hand"
                  DisplayMemberPath="Name"
                  FontSize="18"
                  IsDropDownOpen="{Binding SelectionVisible, Mode=TwoWay}"
                  ItemsSource="{Binding Players}"
                  SelectedItem="{Binding SelectedPlayer}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Padding" Value="10,6" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.Template>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <TextBlock FontFamily="pack://application:,,,/Assets/#Fontin"
                                                   FontSize="22"
                                                   Foreground="#f0d0a8"
                                                                                                      Opacity="0.8"
                                                   Text="{Binding DisplayName}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Top"
                               StaysOpen="False">
                            <Border MinWidth="280"
                                    Background="#1a1a1a"
                                    BorderBrush="#af8404"
                                    BorderThickness="2"
                                    CornerRadius="4">
                                <StackPanel Margin="6">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                    <Separator Margin="0,6" Background="#af8404" />
                                    <Button Margin="4,0"
                                            Padding="10,6"
                                            HorizontalContentAlignment="Left"
                                            cal:Message.Attach="[Event Click] = [Action NewCharacter]"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Content="New character"
                                            Cursor="Hand"
                                            FontSize="18"
                                            Foreground="#f0d0a8" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </ComboBox.Template>
        </ComboBox>
    </Grid>
</UserControl>
